{
  "name": "muse-desktop",
  "version": "0.4.2",
  "private": true,
  "license": "MIT",
  "description": "Minion \u2014 the Detroit Automation Academy's desktop client for macOS High Sierra",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test electron/main.test.cjs test/packaging.test.cjs"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.detroitautomationacademy.minion",
    "productName": "Minion",
    "artifactName": "Minion-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "synopsis": "Minion desktop client",
      "maintainer": "Detroit Automation Academy",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "icon": "build/icon.png"
  },
  "author": "Detroit Automation Academy",
  "homepage": "https://detroitautomationacademy.com",
  "desktopName": "minion"
}
